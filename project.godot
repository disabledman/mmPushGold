; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="推金幣遊戲"
config/description="Push Gold Coin Game - Single player casual game"
config/tags=PackedStringArray("3d", "physics")
run/main_scene="res://scenes/Logo.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/show_image=false

[autoload]

GameManager="*res://scripts/GameManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[physics/common]

# 提高物理步進率，讓大量剛體堆疊更穩、減少上層硬幣抖動
physics_ticks_per_second=120

[dotnet]

project/assembly_name="推金幣遊戲"

[layer_names]

2d_physics/layer_1="coins"
2d_physics/layer_2="catch_zone"
2d_physics/layer_3="game_area"

[physics]

# 讓大量剛體堆疊更快入睡，降低視覺微抖動
3d/sleep_threshold_linear=0.06
3d/sleep_threshold_angular=0.12
3d/time_before_sleep=0.2

[rendering]

textures/vram_compression/import_etc2_astc=true
